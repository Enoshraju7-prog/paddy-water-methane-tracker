# cp .env.example .env
#
# No API keys are needed for any v1 data source:
#   Sentinel-1 / Sentinel-2  → Microsoft Planetary Computer (anonymous, free)
#   NASA POWER               → free, keyless
#   SoilGrids (ISRIC)        → free, keyless
# Everything below is a tuning knob, not a secret.

# ── Study area (WGS84) — replace after field visit 1 ────────────────
BBOX_MIN_LON=81.70
BBOX_MIN_LAT=16.60
BBOX_MAX_LON=82.10
BBOX_MAX_LAT=16.95

# ── Season ──────────────────────────────────────────────────────────
SEASON_START=2025-06-15
SEASON_END=2025-11-15
PRESEASON_DAYS=180

# ── Flood detection ─────────────────────────────────────────────────
S1_VV_FLOOD_THRESHOLD_DB=-16.0
S1_ORBIT_DIRECTION=descending
S1_USE_VH_RATIO=true

# ── Methane model ───────────────────────────────────────────────────
EF_C_BASELINE=1.19
GWP_CH4=27.0
DEFAULT_CULTIVATION_DAYS=120

# ── Water & pumping — replace with numbers from real farmers ────────
SEASONAL_IRRIGATION_MM=1200
PUMP_DISCHARGE_M3_PER_HOUR=40
COST_PER_PUMP_HOUR_INR=60

# ── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://varaha:varaha@localhost:5432/varaha
