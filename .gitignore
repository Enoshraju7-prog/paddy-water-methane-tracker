# ── Data ─────────────────────────────────────────────────────────────
# Raw satellite downloads are large and re-fetchable. Never commit them.
data/raw/
data/interim/
data/processed/

# ── Field data: PRIVACY, not size ────────────────────────────────────
# Real boundaries + interview transcripts identify real people.
# Only the anonymised, coordinate-jittered sample is committed.
data/fields/*
!data/fields/.gitkeep
!data/fields/fields.sample.geojson
references/interviews/
references/*_raw.md

# Models
models/*.pkl
models/*.joblib
models/*.pt

# Reports output
reports/figures/*.png
reports/figures/*.jpg
reports/figures/*.svg

# Frontend
frontend/node_modules/
frontend/dist/

# macOS
.DS_Store
.AppleDouble
