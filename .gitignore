# Python
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.eggs/

# Environments
.env
.venv
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# VS Code
.vscode/
*.code-workspace

# ── Data ─────────────────────────────────────────────────────────────
# Raw satellite downloads are large and re-fetchable. Never commit them.
data/raw/
data/interim/
data/processed/

# ── Field data: PRIVACY, not size ────────────────────────────────────
# Real boundaries, interviews and photos identify real people.
# Only anonymised samples and empty templates are committed.
data/fields/*
!data/fields/.gitkeep
!data/fields/fields.sample.geojson
!data/fields/*.template.csv
data/fields/photos/
references/interviews/
references/*_raw.md

# Models
models/*.pkl
models/*.joblib
models/*.pt

# Reports output — regenerated by the pipeline, so not tracked.
# Figures meant for the README or docs go in docs/img/ instead, and ARE tracked.
reports/figures/*.png
reports/figures/*.jpg
reports/figures/*.svg

# Frontend
frontend/node_modules/
frontend/dist/

# macOS
.DS_Store
.AppleDouble
